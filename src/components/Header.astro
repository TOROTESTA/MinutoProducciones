---
export interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<header class="site-head" data-header>
  <div class="site-head-container">
    <!-- Burger -->
    <button
      class="nav-burger"
      type="button"
      aria-label="Abrir menú"
      aria-controls="navigation"
      aria-expanded="false"
      data-burger
    >
      <div class="hamburger hamburger--collapse">
        <div class="hamburger-box">
          <div class="hamburger-inner" />
        </div>
      </div>
    </button>

    <!-- Nav -->
    <nav id="navigation" class="site-head-left" aria-label="Navegación principal">
      <ul class="nav" role="menu">
        <li role="menuitem"><a href="/">Home</a></li>
        <li role="menuitem"><a href="/bio">Eventos</a></li>
        <li role="menuitem"><a href="/work">Nosotros</a></li>
        <li role="menuitem"><a href="/contact">Contacto</a></li>
      </ul>
    </nav>

    <!-- Logo SIEMPRE visible -->
    <div class="site-head-center">
      <a class="site-head-logo" href="/" aria-label="Minuto Producciones">
        <img
          src="/img/MinutoProd-Logo-01.png"
          alt="Minuto Producciones"
          class="site-head-logo-img"
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <div class="site-head-right">
     <div class="header-socials">
      <a
      href="INSTAGRAM_URL"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 2C4.243 2 2 4.243 2 7v10c0 2.757 2.243 5 5 5h10c2.757 0 5-2.243 5-5V7c0-2.757-2.243-5-5-5H7zm10 2c1.654 0 3 1.346 3 3v10c0 1.654-1.346 3-3 3H7c-1.654 0-3-1.346-3-3V7c0-1.654 1.346-3 3-3h10zm-5 3a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6zm4.5-.9a1.1 1.1 0 100 2.2 1.1 1.1 0 000-2.2z"/>
      </svg>
    </a>

    <a
      href="LINKEDIN_URL"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4.98 3.5a2.5 2.5 0 110 5 2.5 2.5 0 010-5zM3 8.98h3.96V21H3V8.98zM9.5 8.98h3.8v1.64h.05c.53-1 1.82-2.05 3.75-2.05 4 0 4.74 2.63 4.74 6.05V21h-3.96v-5.2c0-1.24-.02-2.83-1.73-2.83-1.73 0-2 1.35-2 2.74V21H9.5V8.98z"/>
      </svg>
    </a>
  </div>
</div>

    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const burger = document.querySelector('[data-burger]');

  if (header && burger) {
    burger.addEventListener('click', () => {
      const isOpen = header.classList.toggle('nav-open');
      burger.setAttribute('aria-expanded', String(isOpen));
    });

    // Cierra menú al navegar (opcional)
    header.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        header.classList.remove('nav-open');
        burger.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

<style>
  /* Logo: evita recortes */
  .site-head-logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .site-head-logo-img {
    height: 90px;        /* <-- bajá desde 100px */
    width: auto;
    display: block;
    object-fit: contain;
    max-width: 220px;    /* evita que se coma todo */
  }

  /* Burger button reset */
  .nav-burger {
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    display: none; /* desktop: oculto */
  }

  /* Mobile */
  @media (max-width: 900px) {
    .nav-burger {
      display: inline-flex;
      align-items: center;
    }

    /* El nav pasa a ser desplegable */
    .site-head-left {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      padding: 12px 16px;
      z-index: 50;
      background: rgba(0,0,0,0.95);
      backdrop-filter: blur(8px);
    }

    header.site-head.nav-open .site-head-left {
      display: block;
    }

    .site-head-container {
      position: relative; /* para que el nav absoluto se ancle acá */
    }

    /* Logo más chico en mobile para que no se corte */
    .site-head-logo-img {
      height: 50px;
      max-width: 160px;
    }
  }
  .header-socials {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .header-socials a {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(0,0,0,0.06);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .header-socials a:hover {
    transform: translateY(-1px);
    background: rgba(0,0,0,0.12);
  }

  .header-socials svg {
    width: 22px;
    height: 22px;
    fill: #111;
  }

  /* Mobile */
  @media (max-width: 700px) {
  .header-socials a { width: 40px; height: 40px; }
  .header-socials svg { width: 22px; height: 22px; }
  }

  
</style>

